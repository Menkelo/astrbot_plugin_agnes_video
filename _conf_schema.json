{
  "api_keys": {
    "description": "API Key 列表",
    "type": "list",
    "default": [],
    "hint": "每项填写一个在 Agnes AI 官网申请的 API Key。配置多个 Key 时插件会轮询使用"
  },
  "base_url": {
    "description": "Agnes API 网关地址",
    "type": "string",
    "hint": "一般无需修改",
    "default": "https://apihub.agnes-ai.com"
  },
  "model": {
    "description": "视频生成模型名称",
    "type": "string",
    "default": "agnes-video-2.5-flash",
    "hint": "模型输出固定为 720P，仅支持 agnes-video-2.5-flash"
  },
  "aspect_ratio": {
    "description": "默认视频宽高比",
    "type": "string",
    "options": ["16:9", "9:16", "1:1", "4:3", "3:4", "21:9"],
    "labels": ["16:9 横版", "9:16 竖版", "1:1 方形", "4:3 传统横版", "3:4 竖版肖像", "21:9 超宽屏"],
    "default": "16:9",
    "hint": "文生视频的默认比例；图生视频 / 关键帧动画会自动按参考图比例映射。提示词中也可指定比例覆盖，如 16:9"
  },
  "duration_seconds": {
    "description": "默认视频时长（秒）",
    "type": "string",
    "options": ["4", "5", "6", "8", "10", "12"],
    "labels": ["约 4 秒", "约 5 秒", "约 6 秒", "约 8 秒", "约 10 秒", "约 12 秒"],
    "default": "5",
    "hint": "支持 4-12 秒；提示词中可指定秒数覆盖，如 10s"
  },
  "seed": {
    "description": "随机种子（-1 表示随机）",
    "type": "int",
    "default": -1,
    "hint": "设置固定种子可生成可复现的结果"
  },
  "poll_interval": {
    "description": "任务轮询间隔（秒）",
    "type": "int",
    "default": 5
  },
  "max_poll_time": {
    "description": "后台等待任务完成的最大时间（秒）",
    "type": "int",
    "default": 600,
    "hint": "超时后插件会停止轮询并提示仍在后台生成"
  }
}

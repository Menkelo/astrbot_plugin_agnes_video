{
  "api_key": {
    "description": "Agnes AI API Key",
    "type": "string",
    "hint": "在 Agnes AI 官网申请获取",
    "obvious_hint": true
  },
  "base_url": {
    "description": "API 网关地址",
    "type": "string",
    "hint": "一般无需修改",
    "default": "https://apihub.agnes-ai.com"
  },
  "model": {
    "description": "视频生成模型名称",
    "type": "string",
    "default": "agnes-video-v2.0"
  },
  "aspect_ratio": {
    "description": "默认视频宽高比",
    "type": "string",
    "options": ["16:9", "9:16", "1:1", "4:3", "3:4"],
    "labels": ["16:9 横版", "9:16 竖版", "1:1 方形", "4:3 传统横版", "3:4 竖版肖像"],
    "default": "4:3",
    "hint": "文生视频的默认比例；图生视频 / 关键帧会自动按参考图比例映射。提示词中也可指定比例覆盖，如 16:9"
  },
  "duration_seconds": {
    "description": "默认视频时长",
    "type": "string",
    "options": ["3", "5", "10", "18"],
    "labels": ["约 3 秒", "约 5 秒", "约 10 秒", "约 18 秒"],
    "default": "5",
    "hint": "提示词中可指定秒数覆盖，如 10s；非标准秒数会自动映射到最近档位"
  },
  "seed": {
    "description": "随机种子（-1 表示随机）",
    "type": "int",
    "default": -1,
    "hint": "设置固定种子可生成可复现的结果"
  },
  "poll_interval": {
    "description": "任务轮询间隔（秒）",
    "type": "int",
    "default": 5
  },
  "max_poll_time": {
    "description": "后台等待任务完成的最大时间（秒）",
    "type": "int",
    "default": 600,
    "hint": "超时后仅返回任务 ID，可通过 /vgen status 继续查询"
  }
}
